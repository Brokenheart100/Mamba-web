# Set a long random secret for stable resource signatures across restarts/instances.
NUXT_PLAYBACK_SECRET=
# Set false to disable the bundled third-party video source.
NUXT_SOURCE_ENABLED=true
# Apply for your own application credentials at https://dev.dandanplay.com/.
# Private server config. Never use NUXT_PUBLIC_* for these credentials.
NUXT_DANDANPLAY_ENABLED=true
NUXT_DANDANPLAY_APP_ID=
NUXT_DANDANPLAY_APP_SECRET=
# Optional comma-separated, exact CDN hostnames if the official service redirects
# outside dandanplay.net / dandanplay.com. Leave empty unless confirmed by the provider.
NUXT_DANDANPLAY_CDN_HOSTS=
# Production Node entrypoint reads environment variables, not this file automatically.
HOST=127.0.0.1
PORT=3100
